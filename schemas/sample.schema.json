{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "t2i-explorer/sample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sample_id",
    "index",
    "input_text",
    "pred_text",
    "gt_text",
    "panels",
    "metadata"
  ],
  "properties": {
    "sample_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "input_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "pred_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "gt_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "asset"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "asset": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^assets/[A-Za-z0-9._/-]+$"
          },
          "unavailable_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "asset": {
                  "type": "null"
                }
              }
            },
            "then": {
              "required": [
                "unavailable_reason"
              ],
              "properties": {
                "unavailable_reason": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "extra_texts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "text"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
