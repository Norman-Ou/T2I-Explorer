{
  "$id": "t2i-explorer/record-v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "sample_index",
    "source_sample_id",
    "review_stage",
    "message_input_text",
    "message_output_text",
    "source_annotation_text",
    "source_dataset",
    "source_split",
    "source_manifest_path",
    "panel_roles",
    "asset_paths",
    "evidence"
  ],
  "properties": {
    "sample_index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "source_sample_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "review_stage": {
      "enum": [
        "accepted_e6_sft_row",
        "official_training_execution",
        "official_preview_loader_execution",
        "official_method_extension",
        "paper_example",
        "source_annotation_audit"
      ]
    },
    "message_input_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "message_output_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_annotation_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "paper_input_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "paper_output_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_dataset": {
      "type": "string",
      "minLength": 1
    },
    "source_split": {
      "type": "string",
      "minLength": 1
    },
    "source_manifest_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "panel_roles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "asset_paths": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object"
    }
  }
