{
  "$id": "t2i-explorer/manifest-v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_schema_version",
    "id",
    "title",
    "models"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "record_schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "models": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "steps"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "steps": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "review_stage",
                "status",
                "record_count",
                "target_count"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "review_stage": {
                  "enum": [
                    "accepted_e6_sft_row",
                    "official_training_execution",
                    "official_preview_loader_execution",
                    "official_method_extension",
                    "paper_example",
                    "source_annotation_audit"
                  ]
                },
                "status": {
                  "enum": [
                    "complete",
                    "partial",
                    "blocked"
                  ]
                },
                "record_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 30
                },
                "target_count": {
                  "const": 30
                },
                "shortfall_reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              }
            }
          }
        }
      }
    }
  }
}
