{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "t2i-explorer/experiment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "record_count",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "record_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "metadata": {
      "type": "object"
    }
  }
}
